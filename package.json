{
  "name": "dsh-rss-reader",
  "version": "0.1.0",
  "description": "DSH plugin: an in-harness RSS/Atom reader — subscribe to feeds, browse items in a dedicated panel, refresh on demand, read with the agent",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./xml": "./lib/xml.js",
    "./feed": "./lib/feed.js",
    "./fetch": "./lib/fetch.js",
    "./store": "./lib/store.js",
    "./refresh": "./lib/refresh.js",
    "./api": "./lib/api.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "sync-install": "node scripts/sync-install.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "rss",
    "atom",
    "feed",
    "reader",
    "news"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "schemastery": { "optional": true }
  }
}
